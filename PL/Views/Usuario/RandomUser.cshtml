
@{
    ViewData["Title"] = "RandomUser";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <div class="row">
        <h1 class="text-center display-3">RandomUser</h1>
        <div class="col-md-12 text-center mt-3">
            <table class="table" id="TablaDinamica">
                <thead>
                    <tr>
                        <th scope="col">Title First Last</th>
                        <th scope="col">Gender</th>
                        <th scope="col">State Country</th>
                        <th scope="col">Email</th>
                        <th scope="col">Date</th>
                        <th scope="col">Phone</th>
                        <th scope="col">Picture</th>
                    </tr>
                </thead>
                <tbody>
                    <!--Contenido Dinamico con mi peticion AJAX-->
                </tbody>
            </table>
            <button class="btn btn-outline-info text-center" onclick="GenerarRandomUser()">Generar nuevo Usuario</button>
        </div>
    </div>
</div>

<script type="text/javascript" src="~/js/RandomUser.js"></script>
